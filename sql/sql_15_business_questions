create database tyreretail;
use tyreretail;

-- Preview tables
select * from current_stocks;
select * from sales;
select * from supplier;

-- Analyze tables structure
DESCRIBE current_stocks;
DESCRIBE sales;
DESCRIBE supplier;

-- **Business Questions**

-- Q.1 What is the total revenue and total units sold?
SELECT
	SUM(`Revenue`) as `Total Revenue`,
    SUM(`Units Sold`) as `Total Units Sold`
FROM
	sales;
-- -> Net : 1064503596 (total revenue) &  81418 (total units sold)
SELECT
	SUM(CASE
			WHEN `Transaction Type` = 'Sale'
			THEN Revenue
			ELSE 0
		END) AS `Gross Total Revenue`,
        
	SUM(CASE
			WHEN `Transaction Type` = 'Sale'
            THEN `Units Sold`
            ELSE 0
		END) AS `Gross Units Sold`
FROM 
	Sales;
-- -> Gross : 1064503596 (total revenue) &  81418 (total units sold)

-- Q.2 Which brands generate the highest revenue?
SELECT
	Brand,
    SUM(Revenue) AS Net_Revenue
FROM 
	sales
GROUP BY 
	Brand
ORDER BY 
	Net_Revenue DESC;
-- -> BRAND_C generates highest revenue

-- Q.3 Which 10 products have the highest sales?
SELECT
	`Product ID`,
    `Product Name`,
    SUM(`Units Sold`) AS `Net_Units_Sold`,
    SUM(Revenue) AS `Net_Revenue`
FROM
	Sales
GROUP BY 
	`Product ID`,
    `Product Name`
ORDER BY 
	`Net_Revenue` DESC
LIMIT 10;
-- -> Units sold ranges from 7875 to 409 and Revenue ranges from 210773091 to 14434887 for 10 products having highest sales through Units sold and Revenue.

-- Q.4 What are the monthly sales trends?
SELECT 
	DATE_FORMAT(Date,'%Y-%m') AS Sales_Month,
    SUM(`Units Sold`) AS Net_Units_Sold,
    SUM(`Revenue`) AS Net_Revenue
FROM 
	sales
GROUP BY
	Sales_Month
ORDER BY
	Sales_Month;
-- -> Plot Scatter plot using this monthly data to understand it easily

-- Q.5 Which brands have the highest average selling price?
SELECT
	Brand,
    COUNT(`Units Sold`) AS Net_Units_Sold,
    ROUND(AVG(`Unit Price`),2) AS Avg_Selling_Price
FROM
	sales
WHERE
	`Transaction Type` = 'Sale'
GROUP BY 
	Brand
ORDER BY
	Avg_Selling_Price;
-- Return have positive unit price, but they are not sales transaction. So we filter them out.
-- -> Brand B

-- Q.6 Which price tier generates the most revenue?
SELECT
	`Price Level`,
	SUM(Revenue) AS Net_Revenue,
    SUM(`Units Sold`) AS Net_Units_Sold
FROM
	sales
GROUP BY
	`Price Level`
ORDER BY 
	Net_Revenue DESC;
-- -> Tier 'A'

-- Q.7 What is the return rate by brand?
SELECT
	Brand,
    SUM(CASE
			WHEN `Transaction Type`='Sale'
            THEN `Units Sold`
            ELSE 0
		END) AS Net_Sale,
	ABS(SUM(CASE
				WHEN `Transaction Type`='Return'
                THEN `Units Sold`
                ELSE 0
			END)) AS Net_Return,
	ROUND(ABS((SUM(CASE
				WHEN `Transaction Type`='Return'
                THEN `Units Sold`
                ELSE 0
			END)) /
		SUM(ABS(`Units Sold`))) * 100, 2) AS Return_Rate		-- RETURN VALUES CONSIDERED FOR GROSS UNITS SOLD
FROM
	sales
GROUP BY
	Brand;
-- -> BRAND_C (lOWEST RETURN RATE) < BRAND_D < BRAND_A < BRAND_B (HISHEST RETURN RATE)

-- Q.8 Which products have high sales volume but high return rates?
SELECT
	`Product ID`,
    `Product Name`,
    ROUND((SUM(CASE
			WHEN `Transaction Type`='Sale'
            THEN `Units Sold`
            ELSE 0
		END) 
	/
    SUM(ABS(`Units Sold`))) * 100, 2) AS Sale_Percentage,		-- RETURN VALUES CONSIDERED FOR GROSS UNITS SOLD
    
	ROUND(ABS((SUM(CASE
				WHEN `Transaction Type`='Return'
                THEN `Units Sold`
                ELSE 0
			END))
	/
	SUM(ABS(`Units Sold`))) * 100, 2) AS Return_Rate,
	SUM(ABS(`Units Sold`)) AS Gross_Units_Sold,
    SUM(`Units Sold`) AS Net_Units_Sold
FROM
	sales
GROUP BY
	`Product ID`,
    `Product Name`
HAVING
	Sale_Percentage > 80 OR Return_Rate > 5		-- Threshold assumption Sale_Percentage > 80 AND Return_Rate > 5 because there are some products with 100% return rate
ORDER BY Return_Rate;

-- Q.9 What percentage of revenue comes from the top 10 products?
-- Assume top 10 products by revenue
WITH Product_Revenue AS(
	SELECT
		`Product ID`,
		`Product Name`,
		SUM(Revenue) AS Revenue
	FROM
		sales
	GROUP BY
		`Product ID`,
		`Product Name`),
        
Ranked_Product AS (SELECT 
	*,
	RANK() OVER(ORDER BY Revenue DESC) AS Ranked_Revenue
FROM
	Product_Revenue)

SELECT
	ROUND(
		SUM(CASE
				WHEN Ranked_Revenue <= 10
				THEN Revenue
				ELSE 0
			END)
        /
        SUM(Revenue) * 100,2) AS Percentage_Revenue
FROM
	Ranked_Product;
-- -> 50.29% of revenue comes from the top 10 products.

-- Q.10 Which products are potentially overstocked?

-- Number of days :- Days between the starting date of specific product sold and last date of that product sold
-- Daily average sale = Total_sale of specific product / Number of days
-- Days of Inventory :- How many days the product will take according to the current average sale.
-- Days of Inventory = current stock qty / daily avg sale

WITH Product_Demand AS (
	SELECT
		`Product ID`,
        SUM(CASE
				WHEN `Transaction Type` = 'Sale'
                THEN `Units Sold`
                ELSE 0
			END) AS Total_Sale,
		DATEDIFF(
			MAX(Date),
			MIN(Date)
		) AS Number_of_days
	FROM
		sales
	GROUP BY
		`Product ID`
),

inventory_analysis AS (
	SELECT
		c.`Product ID`,
        c.`Product Name`,
        c.`Last Restock Date`,
        d.Total_Sale,
        d.Number_of_days,
        c.`Current Stock Qty`,
        
        ROUND(d.Total_Sale /
        NULLIF(d.Number_of_days,0),2) AS Daily_Avg_Sale,
        
        ROUND(c.`Current Stock Qty` /
        NULLIF(d.Total_Sale / d.Number_of_days, 0),2) AS Days_Of_Inventory
	FROM
		current_stocks c
	JOIN
		Product_Demand d
	ON c.`Product ID` = d.`Product ID`
)
    
SELECT
	*
FROM 
	inventory_analysis
WHERE 
	Days_Of_Inventory > 90		-- Set threshold for more than 90 days
ORDER BY 
	Days_Of_Inventory DESC;
    
-- Q.Which fast-moving products have insufficient current stock?
WITH product_demand AS (
	SELECT
		`Product ID`,
        SUM(CASE
				WHEN `Transaction Type` = 'Sale'
                THEN `Units Sold`
                ELSE 0
			END) AS Total_Sale,
		DATEDIFF(
			MAX(Date),
            MIN(Date)) AS Number_of_Days
	FROM
		sales
	GROUP BY
		`Product ID`
),

inventory_analysis AS (
	SELECT
		c.`Product ID`,
        c.`Product Name`,
        d.Total_Sale,
        d.Number_of_Days,
        
        ROUND(d.Total_Sale / d.Number_of_Days, 2) AS Daily_avg_Sale,
        
        c.`Current Stock Qty`,
        
        ROUND(
			c.`Current Stock Qty` 
            /
            ROUND(d.Total_Sale / d.Number_of_Days, 2)
		) AS Days_of_Inventory
	FROM
		current_stocks c
	JOIN 
		product_demand d
	ON 
		c.`Product ID`=d.`Product ID`
)

SELECT
	*
FROM
	inventory_analysis
WHERE 
	Daily_avg_Sale > 5 AND `Current Stock Qty` < 50		
ORDER BY 
	Daily_avg_Sale DESC;

-- Assumptions in simple words, 
-- 1. Fast-moving products are the products having the daily sales average above 5.
-- 2. Threshold for insufficient is 50 means if product have the stock less than a 50 then it is insufficient stock.

-- Q.12 Which products may run out before supplier replenishment?
WITH product_demand AS(
	SELECT
        `Product ID`,

        SUM(CASE
				WHEN `Transaction Type` = 'Sale'
                THEN `Units Sold`
                ELSE 0
			END) AS Total_Units_Sold,
            
		DATEDIFF(
			MAX(Date),
            MIN(Date)) AS Number_of_Days
	FROM 
		sales
	GROUP BY
		`Product ID`
),

lead_time_analysis AS (
	SELECT
		p.`Product ID`,
		c.`Product Name`,
        c.`Brand`,
        c.`Current Stock Qty`,
        p.Total_Units_Sold,
        p.Number_of_Days,
		ROUND(
			(p.Total_Units_Sold
            /
            p.Number_of_Days),2) AS Daily_Avg_Sale
	FROM
		product_demand p
	JOIN
		current_stocks c
	ON
		p.`Product ID` = c.`Product ID`
)

SELECT
	l.`Product ID`,
	l.`Product Name`,
	l.`Brand`,
	l.Total_Units_Sold,
	l.Number_of_Days,
    l.Daily_Avg_Sale,
    s.`Avg Lead Time (Days)`,
    l.`Current Stock Qty`,
    
    l.Daily_Avg_Sale * s.`Avg Lead Time (Days)` AS Lead_Time_Demand,
    
    ABS(l.`Current Stock Qty` - (l.Daily_Avg_Sale * s.`Avg Lead Time (Days)`)) AS Stock_Deficit
FROM
	lead_time_analysis l
JOIN
	supplier s
ON 
	l.Brand = s.Brand
WHERE
	l.`Current Stock Qty` < l.Daily_Avg_Sale * s.`Avg Lead Time (Days)`;
-- -> Stock Deficit means the number of stock that might require to fullfill the demand during lead time of supplier.
-- Lead_Time_Demand = Avg Lead Time x Daily_Avg_Sale
-- Stock_Deficit = Current Stock Qty - Lead_Time_Demand

-- Q.13 Which supplier has the greatest lead-time variability?
SELECT
	*
FROM 
	supplier
ORDER BY 
	`Lead Time Std Dev (Days)` DESC;
-- Here, Lead-time variability is represented in the `Lead Time Std Dev`(Standard Deviation) term, (i.e, Deviation from the average lead time day).
-- Lead-time variability means the unpredictability in replenishment time or day.
-- Higher the number of Lead-Time Variablity, higher the uncertainity.

-- Q.14 Which brands combine high demand with high supplier risk?
SELECT
	su.Brand,
    su.`Avg Lead Time (Days)`,
    su.`Lead Time Std Dev (Days)`,
    ROUND(SUM(CASE
			WHEN sa.`Transaction Type` = 'Sale'
            THEN sa.`Units Sold`
            ELSE 0
		END)/sa.Total_Sale,2)*100 AS Percent_Sale,
	SUM(CASE
			WHEN sa.`Transaction Type` = 'Sale'
            THEN sa.`Units Sold`
            ELSE 0
		END) AS Total_Sale
FROM
	supplier su
JOIN
	total_sale sa
ON
	su.Brand = sa.Brand
GROUP BY
	sa.Brand,sa.Total_Sale
ORDER BY
    su.`Lead Time Std Dev (Days)` DESC;
-- ->BRAND_C has high demand that it covers 63% of total sales but also have second highest supplier risk.
